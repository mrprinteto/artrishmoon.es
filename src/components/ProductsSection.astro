---
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import Section from './Section.astro';
import ProductCard from './ProductCard.astro';
import SectionTitle from './SectionTitle.astro';
import SectionDivider from './SectionDivider.astro';

const productOrder: Record<string, number> = {
  'Nombre personalizado': 0,
  'Natalicio personalizado': 1,
  'Cartel infantil': 2,
  'Cumplemeses': 3,
  'Decoración Navideña': 4,
  'Marcapáginas en 3D': 5,
  'Decoración en 3D': 6,
  'Posavasos Monstera': 7,
};

const productos = (await getCollection('productos'))
  .map((producto) => ({
    ...producto,
    priority: producto.data.featured ? 0 : 1,
    customOrder: productOrder[producto.data.title] ?? Number.MAX_SAFE_INTEGER,
  }))
  .sort((a, b) => {
    if (a.priority !== b.priority) return a.priority - b.priority;
    if (a.customOrder !== b.customOrder) return a.customOrder - b.customOrder;
    return a.data.title.localeCompare(b.data.title);
  });

const rotations = ['-rotate-1', 'rotate-1', '-rotate-1', 'rotate-2'];
---

<Section id="productos" style="background-color: var(--surface);">
  <Container>
    <SectionTitle
      title="Productos"
      subtitle="Estos son algunos de los ejemplos que puedo crear para ti:"
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        productos.map((producto, i) => (
          <div class:list={['animate-on-scroll', rotations[i % rotations.length]]} data-delay={String((i % 3) + 1)}>
            <ProductCard producto={producto} />
          </div>
        ))
      }
    </div>
  </Container>
</Section>
<SectionDivider color="var(--bg)" flip />
